<?xml version="1.0" encoding="UTF-8"?>
<icon_design>
    <app_name>H5Pstudio</app_name>
    <colors>
        <color_start>#0f172a</color_start>
        <color_end>#3b82f6</color_end>
    </colors>
    <background_style>
        <ornament>aurora</ornament>
    </background_style>
    <proportions>
        <icon_scale>0.80</icon_scale>
    </proportions>
    <svg_elements>
        <!-- Lensa Optik Belakang / Atmosphere Base -->
        <path d="M20 50 A 30 30 0 1 0 80 50 A 30 30 0 1 0 20 50" fill="url(#glossy-dark)" filter="url(#drop-shadow-sm)"/>

        <!-- Inti Mekanika / AI Core (Crimson ke Emas) -->
        <path d="M40 30 L60 30 L70 50 L60 70 L40 70 L30 50 Z" fill="#be123c"/>
        <path d="M42 32 L58 32 L67 50 L58 68 L42 68 L33 50 Z" fill="#f43f5e" filter="url(#inner-shadow)"/>
        <circle cx="50" cy="50" r="12" fill="#fbbf24" filter="url(#drop-shadow-sm)"/>
        <circle cx="50" cy="50" r="6" fill="#fef08a"/>

        <!-- Prisma Kaca Isometrik (Overlap Refraction) -->
        <path d="M50 20 L80 35 L50 50 L20 35 Z" fill="url(#glossy-white)" class="frosted-glass"/>
        <path d="M20 35 L50 50 L50 80 L20 65 Z" fill="url(#glossy-dark)" opacity="0.6"/>
        <path d="M80 35 L50 50 L50 80 L80 65 Z" fill="url(#glossy-white)" opacity="0.3" class="frosted-glass"/>

        <!-- Micro-Highlights (Specular Lighting) -->
        <ellipse cx="50" cy="25" rx="15" ry="3" fill="#ffffff" opacity="0.8"/>
        <circle cx="30" cy="40" r="1.5" fill="#ffffff"/>
        <circle cx="70" cy="40" r="1.5" fill="#ffffff"/>
        <circle cx="50" cy="65" r="2" fill="#ffffff"/>

        <!-- Typography -->
        <g filter="url(#drop-shadow-sm)">
            <text x="50" y="90" font-family="'Space Grotesk', sans-serif" font-size="24" font-weight="800" text-anchor="middle" fill="#ffffff" letter-spacing="2">H5P</text>
        </g>
    </svg_elements>
    <visual_prompt>Desain mengeksekusi "Melting Geometry" melalui tumpukan prisma isometrik frosted glass yang membungkus inti AI bervolume solid berbentuk heksagon. Penggunaan kurva lingkaran halus di latar belakang memberikan kontras elegan terhadap sudut tajam prisma. Material kaca disimulasikan menggunakan gradient glossy-white dengan class frosted-glass dan opacity berlapis, membiaskan inti emas di dalamnya. Specular highlights ditempatkan secara asimetris pada sudut atas dan sisi mekanika untuk memberikan kesan pencahayaan studio 3D yang hiper-realistis.</visual_prompt>
</icon_design>
