<?xml version="1.0" encoding="UTF-8"?>
<icon_design>
    <app_name>MathDuel</app_name>
    <colors>
        <color_start>#0f172a</color_start>
        <color_end>#020617</color_end>
    </colors>
    <background_style>
        <ornament>aurora</ornament>
    </background_style>
    <proportions>
        <icon_scale>0.85</icon_scale>
    </proportions>
    <svg_elements>
        <!-- HANYA GEOMETRI PADAT BERVOLUME (NO STROKE) - MELTING GEOMETRY -->
        
        <!-- Layer 1: Base Arena Kaca Es (Frosted Glass) -->
        <circle cx="50" cy="50" r="42" fill="url(#glossy-white)" class="frosted-glass" filter="url(#drop-shadow-sm)"/>

        <!-- Layer 2: Simbol Tambah (P1 - Biru) Bertabrakan -->
        <g filter="url(#inner-shadow)">
            <rect x="15" y="38" width="32" height="12" rx="4" fill="#3b82f6" transform="rotate(-15 31 44)"/>
            <rect x="25" y="28" width="12" height="32" rx="4" fill="#3b82f6" transform="rotate(-15 31 44)"/>
        </g>
        
        <!-- Highlight Glossy P1 -->
        <rect x="17" y="40" width="28" height="4" rx="2" fill="url(#glossy-white)" transform="rotate(-15 31 44)"/>

        <!-- Layer 3: Simbol Kali (P2 - Merah/Pink) Bertabrakan -->
        <g filter="url(#inner-shadow)">
            <rect x="52" y="52" width="32" height="12" rx="4" fill="#ef4444" transform="rotate(35 68 58)"/>
            <rect x="62" y="42" width="12" height="32" rx="4" fill="#ef4444" transform="rotate(35 68 58)"/>
        </g>

        <!-- Highlight Glossy P2 -->
        <rect x="54" y="54" width="28" height="4" rx="2" fill="url(#glossy-white)" transform="rotate(35 68 58)"/>

        <!-- Layer 4: Petir Emas Murni (Simbol Kecepatan Duel) Membelah Arena -->
        <g filter="url(#drop-shadow-sm)">
            <!-- Siluet Bawah Petir untuk Dimensi -->
            <path d="M 58 8 L 32 48 L 48 48 L 40 92 L 72 45 L 52 45 Z" fill="#854d0e" filter="url(#inner-shadow)"/>
            
            <!-- Petir Utama Emas -->
            <path d="M 55 12 L 35 45 L 50 45 L 43 85 L 68 43 L 50 43 Z" fill="#eab308" />
            
            <!-- Kilau Kaca Mengkilap pada Petir -->
            <path d="M 52 18 L 38 42 L 48 42 L 45 75 L 62 44 L 49 44 Z" fill="url(#glossy-white)" />
        </g>
    </svg_elements>
    <visual_prompt>Ikon MathDuel V2 bergaya Apple Vision Pro (3D Spasial). Latar belakang dark-slate menonjolkan arena alas kaca es bundar. Di atasnya, simbol 'Tambah' biru tebal dan 'Kali' merah tebal saling bertabrakan (terlempar dari rotasi). Tepat di tengah, struktur terbelah oleh petir emas bervolume tebal berlapis resin mengkilap. Seluruh pengerjaan layer menggunakan cetakan padat bersudut halus, tanpa satupun garis luar, untuk memberikan nuansa kedalaman optik yang sangat premium.</visual_prompt>
</icon_design>
