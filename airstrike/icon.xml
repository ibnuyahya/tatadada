<?xml version="1.0" encoding="UTF-8"?>
<icon_design>
    <app_name>Air Strike 1945</app_name>
    <colors>
        <color_start>#1a1f2e</color_start> <!-- Dark Gunmetal -->
        <color_end>#0f172a</color_end>     <!-- Obsidian Night -->
    </colors>
    <background_style>
        <ornament>aurora</ornament>
    </background_style>
    <proportions>
        <icon_scale>0.80</icon_scale>
    </proportions>
    <svg_elements>
        <!-- MASTERPIECE: Hyper-Realistic Metal & Liquid Glass Fighter Jet -->
        <!-- Atmosphere Base: Soft Radar Sweep Glow -->
        <circle cx="50" cy="50" r="30" fill="#3b82f6" opacity="0.1" filter="url(#drop-shadow-sm)" />
        <circle cx="50" cy="50" r="20" fill="#3b82f6" opacity="0.2" />

        <!-- Layer 1: Plane Shadow & Exhaust Aura -->
        <path d="M50 25 L65 55 L75 60 L50 85 L25 60 L35 55 Z" fill="#000" opacity="0.4" filter="url(#drop-shadow-sm)" />
        <circle cx="40" cy="75" r="8" fill="#ff4400" opacity="0.6" filter="url(#drop-shadow-sm)" />
        <circle cx="60" cy="75" r="8" fill="#ff4400" opacity="0.6" filter="url(#drop-shadow-sm)" />

        <!-- Layer 2: Core Silhouette (Twin Fuselage Resin Plating) -->
        <path d="M25 45 Q30 40 35 45 L35 75 Q30 80 25 75 Z" fill="url(#glossy-dark)" filter="url(#inner-shadow)" />
        <path d="M75 45 Q70 40 65 45 L65 75 Q70 80 75 75 Z" fill="url(#glossy-dark)" filter="url(#inner-shadow)" />
        
        <!-- Main Wings (Titanium Alloy) -->
        <path d="M15 50 Q30 45 50 45 Q70 45 85 50 L85 55 Q70 52 50 52 Q30 52 15 55 Z" fill="url(#glossy-white)" opacity="0.8" filter="url(#inner-shadow)" />
        
        <!-- Central Pod (Aircraft Nose) -->
        <path d="M50 20 Q55 25 55 45 Q50 65 45 45 Q45 25 50 20 Z" fill="url(#glossy-dark)" filter="url(#inner-shadow)" />

        <!-- Layer 3: Inner Mechanics (Refractive Cockpit & Red Noses) -->
        <!-- Noses -->
        <circle cx="30" cy="42" r="3" fill="#ef4444" />
        <circle cx="70" cy="42" r="3" fill="#ef4444" />
        <!-- Cockpit Base -->
        <ellipse cx="50" cy="38" rx="4" ry="8" fill="#0ea5e9" />

        <!-- Layer 4: Overlays & Refraction (Liquid Frosted Glass on Cockpit) -->
        <ellipse cx="50" cy="38" rx="4" ry="8" class="frosted-glass" filter="url(#inner-shadow)" />

        <!-- Layer 5: Micro-Highlights (Studio Lighting Speculars) -->
        <!-- Cockpit Glare -->
        <path d="M48 32 Q50 30 52 32 Q50 36 48 32" fill="#ffffff" opacity="0.8" />
        <!-- Wing Stars -->
        <circle cx="25" cy="52" r="2.5" fill="#ffffff" opacity="0.9" />
        <circle cx="75" cy="52" r="2.5" fill="#ffffff" opacity="0.9" />
        <!-- Engine Core LED -->
        <circle cx="40" cy="73" r="2" fill="#fcd34d" opacity="0.9" />
        <circle cx="60" cy="73" r="2" fill="#fcd34d" opacity="0.9" />
    </svg_elements>
    <visual_prompt>Siluet logam gelap berlapis kaca buram, memproyeksikan pencahayaan studio. Moncong pesawat P-38 dibentuk dari path asimetris yang melengkung elegan menggunakan kurva Bezier Q (Quadratic). Kaca kokpit diisi material frosted-glass refraktif, menangkap cahaya mikro (specular) persis di kurva atasnya.</visual_prompt>
</icon_design>
