<?xml version="1.0" encoding="UTF-8"?>
<icon_design>
    <app_name>AlatWasap</app_name>
    <colors>
        <color_start>#25D366</color_start> <!-- WhatsApp Green -->
        <color_end>#075E54</color_end>   <!-- Deep Emerald -->
    </colors>
    <background_style>
        <ornament>ios17_fluid_wave</ornament>
    </background_style>
    <proportions>
        <icon_scale>0.85</icon_scale>
    </proportions>
    <svg_elements>
        <!-- LAYER 1: Shadow Gelembung Chat -->
        <path d="M 20 25 L 80 25 C 90 25 95 30 95 45 L 95 70 C 95 80 90 85 80 85 L 35 85 L 15 100 L 15 85 C 10 85 5 80 5 70 L 5 45 C 5 30 10 25 20 25 Z" fill="#000000" opacity="0.15" filter="url(#drop-shadow-sm)" transform="translate(3, 5)"/>
        
        <!-- LAYER 2: Gelembung Chat Utama (Vibrant Depth) -->
        <path d="M 20 25 L 80 25 C 90 25 95 30 95 45 L 95 70 C 95 80 90 85 80 85 L 35 85 L 15 100 L 15 85 C 10 85 5 80 5 70 L 5 45 C 5 30 10 25 20 25 Z" fill="url(#glossy-white)" filter="url(#inner-shadow)"/>
        <path d="M 20 25 L 80 25 C 90 25 95 30 95 45 L 95 70 C 95 80 90 85 80 85 L 35 85 L 15 100 L 15 85 C 10 85 5 80 5 70 L 5 45 C 5 30 10 25 20 25 Z" fill="url(#main-gradient)" opacity="0.95"/>
        
        <!-- LAYER 3: Simbol Petir / Zap (Aksi Cepat & Direct Chat) -->
        <!-- Bayangan Petir -->
        <polygon points="65,15 35,55 50,55 40,85 75,45 55,45" fill="#000000" opacity="0.2" filter="url(#drop-shadow-sm)" transform="translate(2, 4)"/>
        <!-- Basis Petir (Putih Glossy) -->
        <polygon points="65,15 35,55 50,55 40,85 75,45 55,45" fill="#ffffff" filter="url(#inner-shadow)"/>
        <!-- Warna Emas/Amber pada Petir -->
        <polygon points="65,15 35,55 50,55 40,85 75,45 55,45" fill="#fbbf24" opacity="0.85"/>
        
        <!-- LAYER 4: Sparkles / Keajaiban Format Otomatis -->
        <!-- Kilauan Atas Kiri -->
        <circle cx="28" cy="35" r="4.5" fill="#ffffff" filter="url(#drop-shadow-sm)"/>
        <!-- Kilauan Bawah Kanan -->
        <circle cx="78" cy="72" r="3" fill="#ffffff" opacity="0.9"/>
        <!-- Kilauan Kecil Atas Kanan -->
        <circle cx="85" cy="32" r="2" fill="#ffffff" opacity="0.7"/>
    </svg_elements>
    <visual_prompt>Ikon ini mencerminkan identitas terkini "AlatWasap" yang berfokus pada kecepatan alat (Direct Chat) dan transformasi (Auto-Formatter). Gelembung chat hijau khas ekosistem Apple menjadi kanvas utama bervolume tebal (Vibrant Depth). Di tengahnya, sebuah petir bervolume padat (Zap) berwarna emas bersinar menembus gelembung, melambangkan aksi instan. Sparkle (kilauan sirkuler) di sekitarnya mewakili "keajaiban" algoritma konversi AI ke format WhatsApp. Semuanya dibangun dengan tumpukan geometri solid tanpa satupun garis outline (stroke).</visual_prompt>
</icon_design>
