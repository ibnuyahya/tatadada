<?xml version="1.0" encoding="UTF-8"?>
<icon_design>
    <app_name>MATOWY</app_name>
    <colors>
        <color_start>#0ea5e9</color_start>
        <color_end>#8b5cf6</color_end>
    </colors>
    <background_style>
        <ornament>aurora</ornament>
    </background_style>
    <proportions>
        <icon_scale>0.85</icon_scale>
    </proportions>
    <svg_elements>
        <!-- Base Frosted Frame -->
        <rect x="8" y="8" width="84" height="84" rx="24" class="frosted-glass" filter="url(#drop-shadow-sm)" />
        
        <!-- Glowing Cosmic Aura Behind Compiler -->
        <circle cx="35" cy="45" r="24" fill="#f43f5e" opacity="0.35" filter="url(#drop-shadow-sm)" />
        
        <!-- Volumetric Compiler Engine (Glossy Dark) -->
        <g filter="url(#drop-shadow-sm)">
            <rect x="18" y="24" width="34" height="52" rx="8" fill="url(#glossy-dark)" filter="url(#inner-shadow)" />
            <!-- Neural/Code Nodes -->
            <circle cx="28" cy="35" r="4" fill="#10b981" filter="url(#inner-shadow)" />
            <circle cx="28" cy="48" r="4" fill="#f59e0b" filter="url(#inner-shadow)" />
            <circle cx="28" cy="61" r="4" fill="#3b82f6" filter="url(#inner-shadow)" />
        </g>
        
        <!-- Output A4 Paper Sliding Out (Glossy White) -->
        <g filter="url(#drop-shadow-sm)">
            <rect x="42" y="14" width="42" height="62" rx="5" fill="url(#glossy-white)" filter="url(#inner-shadow)" />
            <!-- Document Formatting Lines -->
            <rect x="52" y="28" width="24" height="4.5" rx="2" fill="url(#glossy-dark)" filter="url(#inner-shadow)" />
            <rect x="52" y="40" width="16" height="4.5" rx="2" fill="url(#glossy-dark)" filter="url(#inner-shadow)" />
            <rect x="52" y="52" width="20" height="4.5" rx="2" fill="url(#glossy-dark)" filter="url(#inner-shadow)" />
        </g>
        
        <!-- Tipografi (Akan dihapus otomatis oleh parser favicon MATOWY) -->
        <text x="50" y="82" font-family="'Space Grotesk', sans-serif" font-weight="bold" font-size="11" fill="#FFFFFF" text-anchor="middle" filter="url(#drop-shadow-sm)"></text>
    </svg_elements>
    <visual_prompt>Evolusi visual MATOWY menuju gaya spasial (visionOS). Menggunakan komposisi 'overlapping volumes' di mana mesin kompilator Markdown (resin gelap) terlihat sedang memproses dan mendorong keluar dokumen A4 (resin putih) ke arah kanan atas. Latar belakang memancarkan aura kosmik untuk menegaskan fungsionalitas cerdas, dan elemen digambar lebih tebal agar mencolok pada ukuran favicon super kecil.</visual_prompt>
</icon_design>
