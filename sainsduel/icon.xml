<?xml version="1.0" encoding="UTF-8"?>
<icon_design>
    <app_name>SainsDuel</app_name>
    <colors>
        <color_start>#020617</color_start>
        <color_end>#0f172a</color_end>
    </colors>
    <background_style>
        <ornament>aurora</ornament>
    </background_style>
    <proportions>
        <icon_scale>0.85</icon_scale>
    </proportions>
    <svg_elements>
        <!-- HANYA GEOMETRI PADAT BERVOLUME (NO STROKE) -->
        
        <!-- Layer 1: Planet Partikel P1 (Cyan) & P2 (Pink) Bertabrakan -->
        <g filter="url(#inner-shadow)">
            <circle cx="35" cy="50" r="28" fill="#0ea5e9" />
            <circle cx="65" cy="50" r="28" fill="#ec4899" />
        </g>
        
        <!-- Layer 1.5: Highlight Glossy (Cahaya Pantulan 3D) untuk Partikel -->
        <circle cx="28" cy="40" r="12" fill="url(#glossy-white)" />
        <circle cx="58" cy="40" r="12" fill="url(#glossy-white)" />

        <!-- Layer 2: Orbit Atom 1 (Solid Glass Ring berlubang) -->
        <path fill-rule="evenodd" d="M 50 15 A 35 15 0 1 0 50 85 A 35 15 0 1 0 50 15 Z M 50 25 A 25 7 0 1 1 50 75 A 25 7 0 1 1 50 25 Z" fill="url(#glossy-white)" class="frosted-glass" transform="rotate(45 50 50)"/>
        
        <!-- Layer 3: Orbit Atom 2 (Solid Glass Ring berlubang) -->
        <path fill-rule="evenodd" d="M 50 15 A 35 15 0 1 0 50 85 A 35 15 0 1 0 50 15 Z M 50 25 A 25 7 0 1 1 50 75 A 25 7 0 1 1 50 25 Z" fill="url(#glossy-white)" class="frosted-glass" transform="rotate(-45 50 50)"/>

        <!-- Layer 4: Inti Petir Neon Hijau (SainsDuel) -->
        <g filter="url(#drop-shadow-sm)">
            <!-- Siluet Petir Belakang (Glow Gelap untuk Kontras Kedalaman) -->
            <path d="M 57 12 L 32 52 L 48 52 L 42 88 L 72 46 L 54 46 Z" fill="#022c22" filter="url(#inner-shadow)"/>
            
            <!-- Petir Utama (Hijau Neon) -->
            <path d="M 55 15 L 35 50 L 50 50 L 45 85 L 70 45 L 52 45 Z" fill="#10b981" />
            
            <!-- Kilau Tajam Petir (Glossy Highlight Tengah) -->
            <path d="M 53 20 L 40 48 L 50 48 L 47 70 L 63 47 L 51 47 Z" fill="url(#glossy-white)" />
        </g>
    </svg_elements>
    <visual_prompt>Desain ikon 3D level Apple Vision Pro. Latar belakang angkasa gelap (Dark Slate) menonjolkan tabrakan dua partikel raksasa: Cyan (Pemain 1) dan Pink (Pemain 2), menciptakan ketegangan duel. Diikat oleh dua cincin orbit atom berbahan kaca es padat (frosted glass) menggunakan sistem fill-rule hollow, sama sekali tanpa garis (stroke). Di tengahnya, sambaran petir hijau neon tebal membelah ruang partikel, melambangkan kecepatan, benturan energi, dan ketangkasan dalam arena SainsDuel.</visual_prompt>
</icon_design>
