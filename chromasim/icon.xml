<?xml version="1.0" encoding="UTF-8"?>
<icon_design>
    <app_name>ChromaSim Pro</app_name>
    <colors>
        <color_start>#020617</color_start> <!-- Slate 950 -->
        <color_end>#1e293b</color_end> <!-- Slate 800 -->
    </colors>
    <background_style>
        <ornament>aurora</ornament>
    </background_style>
    <proportions>
        <icon_scale>0.85</icon_scale>
    </proportions>
    <svg_elements>
        <!-- Lensa Optik Eksterior -->
        <ellipse cx="50" cy="50" rx="42" ry="30" fill="url(#glossy-dark)" filter="url(#drop-shadow-md)" />
        <ellipse cx="50" cy="50" rx="40" ry="28" fill="#ffffff" class="frosted-glass" />
        
        <!-- Pupil Dasar -->
        <circle cx="50" cy="50" r="18" fill="url(#glossy-dark)" filter="url(#inner-shadow)" />
        
        <!-- Sisi Kiri: Visi Normal (Spektrum RGB Padat) -->
        <path d="M50,32 A18,18 0 0,0 32,50 L50,50 Z" fill="#ef4444" />
        <path d="M32,50 A18,18 0 0,0 50,68 L50,50 Z" fill="#3b82f6" />
        
        <!-- Sisi Kanan: Visi Buta Warna (Monokrom/Pudar) -->
        <path d="M50,32 A18,18 0 0,1 68,50 A18,18 0 0,1 50,68 Z" fill="#94a3b8" />
        
        <!-- Cincin Pemisah Kaca (Mewakili Split Screen & Grip Handle) -->
        <rect x="48.5" y="15" width="3" height="70" rx="1.5" fill="url(#glossy-white)" filter="url(#drop-shadow-sm)" />
        
        <!-- Highlight Glossy Lensa (Melting Geometry) -->
        <ellipse cx="40" cy="38" rx="12" ry="5" fill="#ffffff" opacity="0.9" transform="rotate(-20 40 38)" />
        <ellipse cx="60" cy="62" rx="8" ry="3" fill="#ffffff" opacity="0.4" transform="rotate(-20 60 62)" />
    </svg_elements>
    <visual_prompt>Desain ikon premium visionOS dengan tema 'Split Vision'. Menggunakan lensa volumetrik berbentuk elips. Pupil mata dibelah secara fisik oleh pilar/grip frosted-glass putih secara vertikal. Pilar ini memisahkan spektrum merah-biru menyala di sebelah kiri (visi normal) dan silver monokrom di sebelah kanan (visi buta warna). Latar belakang aurora gelap memberikan kesan alat optik saintifik tingkat lanjut.</visual_prompt>
</icon_design>
