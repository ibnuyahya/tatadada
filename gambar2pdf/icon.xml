        <path d="M 25 15 C 30 15 65 15 68 15 C 72 15 75 18 75 22 C 75 40 75 75 75 78 C 75 82 72 85 68 85 C 50 85 30 85 25 85 C 21 85 18 82 18 78 C 18 50 18 25 18 22 C 18 18 21 15 25 15 Z" fill="url(#glossy-white)" filter="url(#drop-shadow-sm)" class="frosted-glass"/>
        
        <!-- Layer 2: Siluet Pemandangan Inti (Gunung Obsidian / Emas) -->
        <path d="M 18 65 C 25 55 30 45 35 45 C 40 45 45 55 52 65 C 55 60 60 55 65 55 C 70 55 75 62 75 65 C 75 80 75 85 68 85 C 40 85 25 85 18 85 Z" fill="url(#glossy-dark)" filter="url(#inner-shadow)"/>
        
