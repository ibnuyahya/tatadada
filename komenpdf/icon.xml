<?xml version="1.0" encoding="UTF-8"?>
<icon_design>
    <app_name>KomenPDF</app_name>
    <colors>
        <!-- Palet Deep Aurora: Fuchsia ke Indigo -->
        <color_start>#c026d3</color_start>
        <color_end>#4338ca</color_end>
    </colors>
    <background_style>
        <ornament>aurora</ornament>
    </background_style>
    <proportions>
        <icon_scale>0.85</icon_scale>
    </proportions>
    <svg_elements>
        <!-- LAYER 1: Bayangan Kertas Belakang (Depth Illusion) -->
        <path d="M 34 26 Q 30 26 30 30 L 30 82 Q 30 86 34 86 L 78 86 Q 82 86 82 82 L 82 42 L 66 26 Z" fill="rgba(0,0,0,0.25)" filter="url(#drop-shadow-sm)" />

        <!-- LAYER 2: Kertas Dokumen Utama (Glossy White dengan Frosted Fold) -->
        <g filter="url(#drop-shadow-sm)">
            <path d="M 24 16 Q 20 16 20 20 L 20 72 Q 20 76 24 76 L 68 76 Q 72 76 72 72 L 72 32 L 56 16 Z" fill="url(#glossy-white)" />
            <!-- Lipatan Kertas Sudut Kanan Atas -->
            <path d="M 56 16 L 56 28 Q 56 32 60 32 L 72 32 Z" fill="#ffffff" class="frosted-glass" filter="url(#inner-shadow)" />
        </g>

        <!-- LAYER 3: Ornamen Header PDF (Kop Surat Abstrak) -->
        <g filter="url(#inner-shadow)">
            <rect x="28" y="24" width="16" height="4" rx="2" class="frosted-glass" />
            <rect x="28" y="32" width="24" height="4" rx="2" class="frosted-glass" />
        </g>

        <!-- LAYER 4: Melting Geometry (Speech Bubble & Extraction Core) -->
        <!-- Menggunakan Inner Shadow untuk meleburkan path bubble dengan lingkaran-lingkaran di sekitarnya menjadi satu bentuk cairan resin -->
        <g filter="url(#inner-shadow)">
            <!-- Main Speech Bubble Shape -->
            <path d="M 44 44 Q 34 44 34 54 L 34 68 Q 34 78 44 78 L 48 78 L 54 86 L 58 78 L 74 78 Q 84 78 84 68 L 84 54 Q 84 44 74 44 Z" fill="url(#bg)" />
            
            <!-- Satellites/Metaballs untuk efek meleleh (Melting/Fluid) -->
            <circle cx="78" cy="42" r="14" fill="url(#bg)" />
            <circle cx="36" cy="46" r="8" fill="url(#bg)" />
            
            <!-- Extracted Data Nodes (Garis dan Titik yang diekstrak) -->
            <rect x="44" y="54" width="26" height="6" rx="3" class="frosted-glass" />
            <rect x="44" y="64" width="16" height="6" rx="3" class="frosted-glass" />
            <circle cx="66" cy="67" r="3" class="frosted-glass" />
        </g>

        <!-- LAYER 5: Titik Fokus Ekstraksi (Glossy Orb yang menyembul keluar) -->
        <circle cx="78" cy="42" r="6" fill="url(#glossy-white)" filter="url(#drop-shadow-sm)" />
    </svg_elements>
    <visual_prompt>Peningkatan dari versi sebelumnya, desain ini memperkenalkan siluet "Deep Aurora" yang menyala. Geometri utama menggunakan prinsip "Melting/Metaball" di mana gelembung komentar menyatu dengan orbit sferis di sudut, mewakili proses ekstraksi cairan data dari kertas dokumen. Seluruh kedalaman ruang dihasilkan melalui kombinasi `inner-shadow`, `glossy-white`, dan lapisan `frosted-glass` solid tanpa satupun garis stroke, menciptakan miniatur 3D taktil yang khas dengan pedoman visual visionOS.</visual_prompt>
</icon_design>
