<?xml version="1.0" encoding="UTF-8"?>
<icon_design>
    <app_name>AcakIcik</app_name>
    <colors>
        <color_start>#0F172A</color_start>
        <color_end>#06B6D4</color_end>
    </colors>
    <background_style>
        <ornament>ios17_fluid_wave</ornament>
    </background_style>
    <proportions>
        <icon_scale>0.82</icon_scale>
    </proportions>
    <svg_elements>
        <!-- Layer 1: Atmosphere Base (Frosted Glass Ring) -->
        <circle cx="50" cy="50" r="44" class="frosted-glass" filter="url(#drop-shadow-sm)" />
        
        <!-- Layer 2: Core Silhouette (Onyx / Resin Gelap) -->
        <g filter="url(#drop-shadow-sm)">
            <!-- Memahat perisai aerodinamis menggunakan kurva Bezier C (Cubic) -->
            <path d="M50 16 C75 16 82 32 82 52 C82 72 60 84 50 88 C40 84 18 72 18 52 C18 32 25 16 50 16 Z" fill="url(#glossy-dark)" filter="url(#inner-shadow)" />
        </g>
        
        <!-- Layer 3: Inner Mechanics (Cybernetic Cyan Prism / Core Data) -->
        <polygon points="50,32 68,44 68,62 50,74 32,62 32,44" fill="#06B6D4" filter="url(#inner-shadow)" opacity="0.95" />
        
        <!-- Layer 4: Overlays & Refraction (Pantulan Kaca Kristal Internal) -->
        <polygon points="50,32 68,44 50,54 32,44" fill="url(#glossy-white)" opacity="0.5" />
        <polygon points="50,54 68,44 68,62 50,74" fill="#000000" opacity="0.25" />
        
        <!-- Layer 5: Micro-Highlights (Pencahayaan Studio & LED) -->
        <!-- Pantulan specular cahaya studio utama di sudut atas prisma -->
        <ellipse cx="44" cy="40" rx="3" ry="2" fill="#FFFFFF" opacity="0.9" transform="rotate(-30 44 40)" />
        <!-- Indikator LED Mikro (Keamanan Aktif) -->
        <circle cx="50" cy="24" r="1.5" fill="#10B981" />
        
        <!-- Layer 6: Haute Couture Typography -->
        <text x="50" y="80" font-family="'Space Grotesk', sans-serif" font-size="10" font-weight="bold" letter-spacing="2.5" fill="#FFFFFF" text-anchor="middle" opacity="0.85">VAULT</text>
    </svg_elements>
    <visual_prompt>Eksekusi teknik "Melting Geometry" untuk menciptakan relik siber super premium. Siluet utama dipahat menggunakan jalur kubik Bezier bertekstur Onyx gelap yang tebal, membungkus prisma heksagonal kristal berwarna Cyber Cyan. Kaca refraksi asimetris ditumpuk di atas prisma dengan opacity bervariasi untuk menciptakan distorsi cahaya, ditambah aksen pencahayaan mikro (specular highlights) berbentuk elips putih pada sudut datang sinar, mencerminkan estetika mewah kelas atas khas Apple Design Award.</visual_prompt>
</icon_design>
