<?xml version="1.0" encoding="UTF-8"?>
<icon_design>
    <app_name>MonKin Studio</app_name>
    <colors>
        <color_start>#FF9500</color_start>
        <color_end>#FF2D55</color_end>
    </colors>
    <background_style>
        <ornament>ios17_fluid_wave</ornament>
    </background_style>
    <proportions>
        <icon_scale>0.85</icon_scale>
    </proportions>
    <svg_elements>
        <!-- Latar Belakang / Framing (Paling Bawah) -->
        <circle cx="50" cy="50" r="42" class="frosted-glass" filter="url(#drop-shadow-sm)" />
        
        <!-- Objek Utama Volumetrik 3D: Cincin Progress (Speedometer) -->
        <g filter="url(#drop-shadow-sm)">
            <g filter="url(#inner-shadow)">
                <!-- Base Track -->
                <circle cx="50" cy="50" r="28" fill="none" stroke="url(#glossy-dark)" stroke-width="12" opacity="0.8" />
                
                <!-- Active Progress Arc (Orange to Red Gradient representation) -->
                <path d="M 50 22 A 28 28 0 0 1 78 50 A 28 28 0 0 1 64 74" fill="none" stroke="#FF9500" stroke-width="12" stroke-linecap="round" />
                
                <!-- Indikator Tengah (Knob) -->
                <circle cx="50" cy="50" r="10" fill="url(#glossy-white)" />
                <circle cx="50" cy="50" r="4" fill="#FF2D55" />
            </g>
        </g>
        
        <!-- Tipografi (Paling Atas) -->
        <text x="50" y="86" font-family="'Righteous', cursive" font-size="11" font-weight="bold" fill="#FFFFFF" text-anchor="middle" filter="url(#drop-shadow-sm)">MONKIN</text>
    </svg_elements>
    <visual_prompt>Ikon merepresentasikan "Monitoring Progress" dengan visual cincin lintasan (circular progress / speedometer) 3D volumetrik. Area gelap sebagai lintasan target, dan garis oranye terang sebagai progress saat ini. Menggunakan palet Oranye-Merah (Sunset) yang kontras dari aplikasi sebelumnya, memberikan nuansa urgensi, energi, dan pelacakan (tracking) waktu nyata khas dashboard Apple Fitness/Activity.</visual_prompt>
</icon_design>
