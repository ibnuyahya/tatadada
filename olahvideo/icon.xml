<?xml version="1.0" encoding="UTF-8"?>
<icon_design>
    <app_name>OlahVideo</app_name>
    <colors>
        <color_start>#4f46e5</color_start> <!-- Indigo Premium -->
        <color_end>#f43f5e</color_end> <!-- Rose Premium -->
    </colors>
    <background_style>
        <ornament>aurora</ornament>
    </background_style>
    <proportions>
        <icon_scale>0.85</icon_scale>
    </proportions>
    <svg_elements>
        <!-- Melting Geometry: Representasi Timeline & Presisi Editing -->
        <g filter="url(#inner-shadow)">
            <!-- Track Kiri (Glossy Gelap - Master Track) -->
            <rect x="18" y="35" width="64" height="30" rx="8" fill="url(#glossy-dark)" />
            
            <!-- Gelombang Audio Abstrak di dalam Track -->
            <rect x="24" y="41" width="14" height="4" rx="2" fill="url(#glossy-white)" opacity="0.2" />
            <rect x="24" y="48" width="8" height="4" rx="2" fill="url(#glossy-white)" opacity="0.2" />
            <rect x="24" y="55" width="12" height="4" rx="2" fill="url(#glossy-white)" opacity="0.2" />
            
            <!-- Klip Kanan (Terpotong / Terpilih - Glossy Putih) -->
            <rect x="46" y="30" width="36" height="38" rx="10" fill="url(#glossy-white)" />
            
            <!-- Ikon Play di dalam Klip -->
            <path d="M 57 41 L 70 49 L 57 57 Z" fill="#f43f5e" />
            
            <!-- Playhead Cyan Tajam Membelah Frame -->
            <rect x="42" y="20" width="5" height="60" rx="2.5" fill="#22d3ee" />
            <circle cx="44.5" cy="20" r="7" fill="#22d3ee" />
            <circle cx="44.5" cy="20" r="2.5" fill="#fff" />
        </g>
    </svg_elements>
    <visual_prompt>Logo OlahVideo diremajakan dengan gaya Apple visionOS (Volume &amp; Depth). Klip cerah di kanan dipotong presisi oleh Playhead Cyan yang tajam dengan komposisi asimetris elegan.</visual_prompt>
</icon_design>
