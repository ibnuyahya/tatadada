<?xml version="1.0" encoding="UTF-8"?>
<icon_design>
    <app_name>UlarTanggaCeria</app_name>
    <colors>
        <color_start>#f59e0b</color_start>
        <color_end>#b45309</color_end>
    </colors>
    <background_style>
        <ornament>ios17_fluid_wave</ornament>
    </background_style>
    <proportions>
        <icon_scale>0.85</icon_scale>
    </proportions>
    <svg_elements>
        <!-- 1. TANGGA KAYU (Background Layer) -->
        <g transform="rotate(-15 35 45)" filter="url(#inner-shadow)" fill="#78350f">
            <!-- Rel Tangga -->
            <rect x="20" y="10" width="7" height="70" rx="3.5" />
            <rect x="45" y="10" width="7" height="70" rx="3.5" />
            <!-- Anak Tangga -->
            <rect x="20" y="25" width="32" height="5" rx="2.5" />
            <rect x="20" y="45" width="32" height="5" rx="2.5" />
            <rect x="20" y="65" width="32" height="5" rx="2.5" />
        </g>

        <!-- 2. ULAR (Melting Geometry - Middle Layer) -->
        <g filter="url(#inner-shadow)" fill="#10b981">
            <!-- Ekor ke Leher (Lingkaran tumpang tindih yang melebur jadi 1 objek) -->
            <circle cx="18" cy="66" r="8" />
            <circle cx="25" cy="57" r="10" />
            <circle cx="35" cy="49" r="11" />
            <circle cx="45" cy="41" r="12" />
            <circle cx="55" cy="33" r="13" />
            <circle cx="65" cy="25" r="15" />
            <!-- Pipi Ular (Memberi volume pada kepala) -->
            <circle cx="55" cy="25" r="11" />
        </g>

        <!-- Corak Perut Ular -->
        <g fill="#34d399">
            <circle cx="26" cy="58" r="4" />
            <circle cx="36" cy="50" r="4.5" />
            <circle cx="46" cy="42" r="5" />
            <circle cx="56" cy="34" r="5.5" />
        </g>

        <!-- Detail Wajah Ular -->
        <!-- Lidah Bercabang (Solid shape) -->
        <path d="M 45 26 L 34 28 L 36 31 L 44 30 Z" fill="#ef4444" />
        <!-- Mata Kiri -->
        <circle cx="60" cy="19" r="4.5" fill="url(#glossy-white)" />
        <circle cx="59" cy="19" r="2" fill="#022c22" />
        <!-- Mata Kanan -->
        <circle cx="70" cy="19" r="4.5" fill="url(#glossy-white)" />
        <circle cx="71" cy="19" r="2" fill="#022c22" />

        <!-- 3. DADU ISOMETRIK (Foreground Layer) -->
        <g filter="url(#drop-shadow-sm)">
            <!-- Sisi Atas -->
            <path d="M 65 45 L 80 55 L 65 65 L 50 55 Z" fill="url(#glossy-white)" filter="url(#inner-shadow)" />
            <!-- Sisi Kiri -->
            <path d="M 50 55 L 65 65 L 65 80 L 50 70 Z" fill="#e2e8f0" filter="url(#inner-shadow)" />
            <!-- Sisi Kanan -->
            <path d="M 65 65 L 80 55 L 80 70 L 65 80 Z" fill="#cbd5e1" filter="url(#inner-shadow)" />
            
            <!-- Titik Dadu Merah (Atas) -->
            <circle cx="65" cy="55" r="3.5" fill="#ef4444" />
            
            <!-- Titik Dadu Biru (Kiri) -->
            <circle cx="56" cy="62" r="2.2" fill="#3b82f6" />
            <circle cx="59" cy="72" r="2.2" fill="#3b82f6" />
            
            <!-- Titik Dadu Hijau (Kanan) -->
            <circle cx="70" cy="61" r="2" fill="#10b981" />
            <circle cx="73" cy="66" r="2" fill="#10b981" />
            <circle cx="76" cy="71" r="2" fill="#10b981" />
        </g>
    </svg_elements>
    <visual_prompt>Upgrade ini menghadirkan komposisi "Trinitas Ular Tangga" secara utuh. Latar belakang memancarkan warna kuning keemasan (Amber) yang hangat dan sangat kontras. Lapisan paling belakang adalah Tangga kayu 3D tebal yang dimiringkan. Di atasnya, seekor ular hijau cerah dibuat dengan teknik "Melting Geometry" (lingkaran yang tumpang tindih membentuk volume) menjulur ke bawah. Di sudut kanan bawah, sebuah Dadu Isometrik tebal menyeimbangkan framing. Semua elemen padat, glossy, tanpa garis luar (stroke), menciptakan sensasi material 3D taktil bergaya premium.</visual_prompt>
</icon_design>
