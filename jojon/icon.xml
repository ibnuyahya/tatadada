        <circle cx="64" cy="36" r="14" fill="#6366f1" filter="url(#inner-shadow)" />
        <circle cx="64" cy="36" r="8" fill="#818cf8" opacity="0.8" />
        
        <!-- Core Feature 3: The Golden Output Forge (XML) -->
        <circle cx="50" cy="64" r="16" fill="#f59e0b" filter="url(#inner-shadow)" />
        <polygon points="50,54 58,68 42,68" fill="#fbbf24" opacity="0.9"/>
        
        <!-- Dynamic Connections: Crystal Glowing Tubes -->
        <path d="M46 36 L 52 36" stroke="#fff" stroke-width="6" stroke-linecap="round" fill="none" opacity="0.8" />
        <path d="M64 48 L 64 54" stroke="#fff" stroke-width="6" stroke-linecap="round" fill="none" opacity="0.8" />
        <path d="M42 64 L 36 64 L 36 46" stroke="#fff" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" fill="none" opacity="0.5" />
        
        <!-- Layer 4: Frosted Glass Refraction Dome over the entire inner mechanism -->
        <rect x="22" y="22" width="56" height="56" rx="14" class="frosted-glass" opacity="0.4" filter="url(#drop-shadow-sm)"/>
        
