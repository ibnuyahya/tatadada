<?xml version="1.0" encoding="UTF-8"?>
<icon_design>
    <app_name>The Mega Pipeline</app_name>
    <colors>
        <color_start>#4f46e5</color_start> <!-- Royal Indigo -->
        <color_end>#0ea5e9</color_end> <!-- Cyan Azure -->
