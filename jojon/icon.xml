        <!-- Base Layer 1: Ambient Dropshadow Plate -->
        <rect x="24" y="32" width="52" height="36" rx="8" fill="#1e1b4b" opacity="0.4" filter="url(#drop-shadow-sm)"/>
        
        <!-- Base Layer 2: Main Outer Pipeline Structure (Onyx / Dark Metal) -->
        <path d="M22 36 C 22 28, 28 22, 36 22 L 64 22 C 72 22, 78 28, 78 36 L 78 64 C 78 72, 72 78, 64 78 L 36 78 C 28 78, 22 72, 22 64 Z" fill="url(#glossy-dark)" filter="url(#inner-shadow)" />
        
        <!-- Base Layer 3: Internal Routing Circuit (Recessed) -->
        <path d="M30 40 L 40 40 Q 50 40 50 50 L 50 60" stroke="#000" stroke-width="4" stroke-linecap="round" fill="none" opacity="0.3"/>
        <path d="M30 60 L 70 60" stroke="#000" stroke-width="4" stroke-linecap="round" fill="none" opacity="0.3"/>
        
        <!-- Core Feature 1: The Liquid Emerald Energy Core (Database/Input) -->
        <circle cx="36" cy="36" r="12" fill="#10b981" filter="url(#inner-shadow)" />
        <circle cx="36" cy="36" r="6" fill="#34d399" opacity="0.8" />
        
