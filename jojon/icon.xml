        <ellipse cx="32" cy="32" rx="3" ry="2" fill="#fff" opacity="0.9" transform="rotate(-45 32 32)"/>
        <ellipse cx="60" cy="32" rx="4" ry="2.5" fill="#fff" opacity="0.9" transform="rotate(-45 60 32)"/>
        <ellipse cx="46" cy="58" rx="4" ry="2.5" fill="#fff" opacity="0.9" transform="rotate(-45 46 58)"/>
        
        <!-- Glowing Data Particles -->
        <circle cx="48" cy="36" r="2" fill="#fff" />
        <circle cx="64" cy="50" r="2" fill="#fff" />
        <circle cx="36" cy="54" r="1.5" fill="#fff" />
