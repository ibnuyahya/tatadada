        <ornament>ios17_fluid_wave</ornament>
    </background_style>
    <proportions>
        <icon_scale>0.82</icon_scale>
    </proportions>
    <svg_elements>
        <!-- Layer 1: Atmosphere Base (Frosted Glass Plate) -->
        <rect x="15" y="15" width="70" height="70" rx="20" class="frosted-glass" filter="url(#drop-shadow-sm)" />
        
        <!-- Layer 2: Core Silhouette (Black Onyx / Obsidian Disc) -->
        <g filter="url(#drop-shadow-sm)">
            <path d="M50 22 A28 28 0 1 1 49.9 22 Z" fill="url(#glossy-dark)" filter="url(#inner-shadow)" />
        </g>

        <!-- Layer 3: Inner Mechanics (Gold Soundwave & Gain Engine) -->
        <g filter="url(#inner-shadow)">
            <!-- Kurva Bezier Organik: Refleksi Frekuensi Audio -->
            <path d="M28 50 C 35 30, 45 70, 50 40 S 60 70, 72 50 L 72 55 C 60 75, 45 35, 50 65 S 35 35, 28 55 Z" fill="#D4AF37" />
