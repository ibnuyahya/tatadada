<?xml version="1.0" encoding="UTF-8"?>
<icon_design>
    <app_name>Idola2 Dasbor Review</app_name>
    <colors>
        <!-- Haute Couture Palette: Deep Obsidian to Imperial Indigo -->
        <color_start>#020617</color_start>
        <color_end>#1e1b4b</color_end>
    </colors>
    <background_style>
        <ornament>aurora</ornament>
    </background_style>
    <proportions>
        <icon_scale>0.85</icon_scale>
    </proportions>
    <svg_elements>
        <!-- LAYER 1: Core Shield Base (Deep Onyx / Resin Base) -->
        <path d="M50 18 C75 18, 85 28, 85 50 C85 75, 50 88, 50 88 C50 88, 15 75, 15 50 C15 28, 25 18, 50 18 Z" 
              fill="url(#glossy-dark)" filter="url(#drop-shadow-sm)"/>
        
        <!-- LAYER 2: Precious Metal Inner Frame (Platinum / Cyan Fusion) -->
        <path d="M50 22 C68 22, 78 30, 78 50 C78 70, 50 82, 50 82 C50 82, 22 70, 22 50 C22 30, 32 22, 50 22 Z" 
              fill="#0ea5e9" opacity="0.25" filter="url(#inner-shadow)"/>
        
        <!-- LAYER 3: The Emerald Lens of Scrutiny (Reviewer Eye) -->
        <circle cx="50" cy="48" r="16" fill="#064e3b" filter="url(#inner-shadow)"/>
        <circle cx="50" cy="48" r="12" fill="#059669"/>
        <circle cx="50" cy="48" r="7" fill="#34d399"/>

        <!-- LAYER 3b: Golden Ribbon Checkmark (Dynamic 3D Bezier Volume) -->
        <path d="M 30 52 Q 40 64 47 72 Q 65 42 80 28 Q 63 50 47 62 Q 38 56 30 52 Z" 
              fill="#fbbf24" filter="url(#drop-shadow-sm)"/>
        <!-- Ribbon Highlight (Simulating bevel & light reflection) -->
        <path d="M 32 53 Q 40 62 46 69 Q 62 44 77 31 Q 61 50 46 61 Q 39 55 32 53 Z" 
              fill="#fef08a" opacity="0.9"/>

        <!-- LAYER 4: Liquid Glass Dome & Refraction -->
        <path d="M22 50 C22 30, 32 22, 50 22 C68 22, 78 30, 78 50 C62 44, 38 44, 22 50 Z" 
              class="frosted-glass" opacity="0.8"/>
        <!-- Inner Glass Specular Arch -->
        <path d="M 35 28 C 45 25, 55 25, 65 28 C 60 32, 40 32, 35 28 Z" 
              fill="url(#glossy-white)" opacity="0.6"/>

        <!-- LAYER 5: Micro-Highlights & Studio Lighting -->
        <!-- Main Lens Light Bounce -->
        <circle cx="45" cy="43" r="2.5" fill="#ffffff" opacity="0.95" filter="url(#drop-shadow-sm)"/>
        <circle cx="48" cy="47" r="1" fill="#ffffff" opacity="0.8"/>
        
        <!-- Golden Ribbon Glint -->
        <ellipse cx="73" cy="36" rx="3.5" ry="1.5" fill="#ffffff" opacity="0.9" transform="rotate(-40 73 36)"/>
        
        <!-- Status Indicator LEDs (Micro Details) -->
        <circle cx="50" cy="85" r="1.5" fill="#34d399" opacity="0.9" filter="url(#drop-shadow-sm)"/>
        <circle cx="50" cy="14" r="1.5" fill="#fbbf24" opacity="0.7" filter="url(#drop-shadow-sm)"/>
    </svg_elements>
    <visual_prompt>Desain ini mengusung tema 'The Sovereign Lens' (Lensa Kedaulatan). Mengeksekusi teknik peleburan geometri (melting geometry) antara perisai Onyx hitam pekat berlapiskan cincin Platinum-Cyan. Di pusatnya tertanam Lensa Zamrud (Emerald Lens) yang merepresentasikan pengawasan ketat, dibungkus oleh Pita Emas (Golden Ribbon) berwujud kurva Bezier asimetris sebagai konseptualisasi tanda centang (checkmark) kemulusan borang. Refraksi kaca buram diposisikan melengkung di kuadran atas untuk efek kubah 3D, dipercantik dengan specular highlights mikro bergaya pencahayaan studio Apple di pinggiran lensa dan sudut pita emas.</visual_prompt>
</icon_design>
