<?xml version="1.0" encoding="UTF-8"?>
<icon_design>
    <app_name>QuizMoodleGen</app_name>
    <colors>
        <color_start>#020617</color_start> <!-- Deep Obsidian Background -->
        <color_end>#0f172a</color_end> <!-- Midnight Slate -->
    </colors>
    <background_style>
        <ornament>aurora</ornament>
    </background_style>
    <proportions>
        <icon_scale>0.85</icon_scale>
    </proportions>
    <svg_elements>
        <!-- Layer 1: Dark Resin Base Plate (Backdrop depth) -->
        <path d="M22,30 C22,18 30,18 50,18 C70,18 78,18 78,30 L78,70 C78,82 70,82 50,82 C30,82 22,82 22,70 Z" fill="url(#glossy-dark)" filter="url(#drop-shadow-sm)"/>
        
        <!-- Layer 2: Geometric Brain/Node Core (Moodle Orange & Cyan) -->
        <!-- Left Cyan Node (Prompt/AI) -->
        <path d="M30,45 C30,35 45,35 45,50 C45,65 30,65 30,45 Z" fill="#06b6d4" filter="url(#inner-shadow)"/>
        <path d="M38,32 C38,25 50,25 50,38 C50,50 38,50 38,32 Z" fill="#0ea5e9" filter="url(#inner-shadow)"/>
        
        <!-- Right Orange Node (Moodle Essence) -->
        <path d="M55,68 C55,75 70,75 70,60 C70,45 55,45 55,68 Z" fill="#f97316" filter="url(#inner-shadow)"/>
        <path d="M48,55 C48,65 65,65 65,48 C65,35 48,35 48,55 Z" fill="#fb923c" filter="url(#inner-shadow)"/>

        <!-- Layer 3: Central Intersection Crystal (Liquid Glass overlay merging tech and learning) -->
        <path class="frosted-glass" d="M40,50 C40,35 60,35 60,50 C60,65 40,65 40,50 Z" filter="url(#inner-shadow)"/>
        
        <!-- Layer 4: Floating Micro-Details & Specular Highlights -->
        <!-- Center glowing core LED -->
        <circle cx="50" cy="50" r="3" fill="#ffffff" opacity="0.9" filter="url(#drop-shadow-sm)"/>
        <!-- Studio lighting highlights -->
        <ellipse cx="28" cy="24" rx="4" ry="2" fill="#ffffff" opacity="0.5" transform="rotate(-30 28 24)"/>
        <ellipse cx="70" cy="24" rx="3" ry="1.5" fill="#ffffff" opacity="0.4" transform="rotate(30 70 24)"/>
        
        <!-- Layer 5: Data Pillars (Representing Options/Answers generation) -->
        <path d="M35,65 Q35,72 40,72 Q45,72 45,65 Q45,58 40,58 Q35,58 35,65 Z" fill="#38bdf8" filter="url(#inner-shadow)"/>
        <path d="M60,32 Q60,25 55,25 Q50,25 50,32 Q50,39 55,39 Q60,39 60,32 Z" fill="#fdba74" filter="url(#inner-shadow)"/>
    </svg_elements>
    <visual_prompt>Masterpiece ini menggunakan teknik "Melting Geometry". Elemen dasar dibuat dari tumpukan kurva Bezier padat yang saling memotong (intersecting paths) antara rona Cyan (AI) dan Orange (Moodle). Lapis tengah menggunakan material Liquid Glass (frosted-glass) untuk membiaskan warna di baliknya. Titik cahaya mikro diletakkan strategis sebagai 'specular highlights' meniru pencahayaan studio 3D yang memantul dari permukaan onyx gelap.</visual_prompt>
</icon_design>
