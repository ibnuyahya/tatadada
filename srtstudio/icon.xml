<?xml version="1.0" encoding="UTF-8"?>
<icon_design>
    <app_name>SRT Studio Pro</app_name>
    <colors>
        <color_start>#4A0E17</color_start>
        <color_end>#F59E0B</color_end>
    </colors>
    <background_style>
        <ornament>ios17_fluid_wave</ornament>
    </background_style>
    <proportions>
        <icon_scale>0.82</icon_scale>
    </proportions>
    <svg_elements>
        <!-- LAYER 1: Atmospheric Baseplate (Frosted Glass Squircle Cinema Frame) -->
        <rect x="14" y="14" width="72" height="72" rx="22" class="frosted-glass" filter="url(#drop-shadow-sm)" />

        <!-- LAYER 2: Sculpted Core Body (Cinema Play Prism & Speech Caption Capsule) -->
        <g filter="url(#drop-shadow-sm)">
            <g filter="url(#inner-shadow)">
                <!-- Sculpted Speech/Subtitle Ribbon Curve -->
                <path d="M 22 36 C 22 25, 34 22, 50 22 C 66 22, 78 25, 78 36 C 78 46, 68 52, 54 52 L 42 60 L 44 52 C 30 52, 22 46, 22 36 Z" fill="url(#glossy-white)" />
                <!-- Obsidian Timecode Core Dial -->
                <circle cx="50" cy="40" r="15" fill="url(#glossy-dark)" />
            </g>
        </g>

        <!-- LAYER 3: Vibrant Inner Mechanics (Play Triangle & Sync Waveform Bars) -->
        <g filter="url(#drop-shadow-sm)">
            <!-- Golden Cinema Play Wedge -->
            <path d="M 46 33 C 46 31.5, 47.5 31, 49 32 L 57 38.5 C 58.5 39.5, 58.5 40.5, 57 41.5 L 49 48 C 47.5 49, 46 48.5, 46 47 Z" fill="#FFD700" filter="url(#inner-shadow)" />
            <!-- Cyber Cyan & Coral Subtitle Track Blocks -->
            <rect x="26" y="61" width="19" height="5" rx="2.5" fill="#00F5D4" filter="url(#inner-shadow)" />
            <rect x="48" y="61" width="26" height="5" rx="2.5" fill="#FF2D55" filter="url(#inner-shadow)" />
        </g>

        <!-- LAYER 4: Refractive Glass Overlay (visionOS Optical Wave) -->
        <path d="M 20 48 C 36 40, 64 40, 80 48 C 75 64, 25 64, 20 48 Z" class="frosted-glass" opacity="0.45" />

        <!-- LAYER 5: Specular Micro-Highlights & Studio Typography -->
        <ellipse cx="36" cy="28" rx="4" ry="1.6" transform="rotate(-18 36 28)" fill="#FFFFFF" opacity="0.85" />
        <circle cx="44" cy="34" r="1.4" fill="#FFFFFF" opacity="0.7" />
        <circle cx="66" cy="29" r="1.8" fill="#FFFFFF" opacity="0.65" />
        <text x="50" y="79" font-family="'Space Grotesk', sans-serif" font-size="10.5" font-weight="700" fill="#FFFFFF" text-anchor="middle" letter-spacing="2" filter="url(#drop-shadow-sm)">SYNC</text>
    </svg_elements>
    <visual_prompt>A sculptural 5-layer visionOS icon combining a glossy white subtitle speech capsule and an obsidian cinema lens core over a Royal Crimson to Amber Gold gradient. Inside the core sits a precision-carved golden play prism above glowing Cyber Cyan and Sunset Coral subtitle timeline bars, veiled by a translucent refractive glass wave and studio specular highlights.</visual_prompt>
</icon_design>
